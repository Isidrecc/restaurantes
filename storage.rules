rules_version = '2';

// Reglas de Storage de Puntuam a taula (docs/diseno.md).
// Consultan los papeles guardados en Firestore (members/{correo}).

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function memberDoc() {
      return /databases/(default)/documents/members/$(request.auth.token.email.lower());
    }
    function hasRole(roles) {
      return signedIn()
        && firestore.exists(memberDoc())
        && firestore.get(memberDoc()).data.role in roles;
    }
    function isEditor() { return hasRole(['owner', 'editor']); }

    // Fotos de cada restaurante. Las suben y borran los editores; las ve cualquiera, sin entrar
    // (app pública en solo lectura desde el 24 de noviembre de 2026).
    match /restaurants/{rid}/{file} {
      allow read: if true;
      allow create: if isEditor()
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.size < 3 * 1024 * 1024;
      allow delete: if isEditor();
    }
  }
}

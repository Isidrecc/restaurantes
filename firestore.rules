rules_version = '2';

// Reglas de Firestore de Puntuam a taula (docs/diseno.md).
// Papeles en members/{correo}: owner (propietario), editor y viewer (invitado que solo mira).
// Puntúa quien es propietario o editor y tiene color (azul o rosa).

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Quién es quién ----------

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function memberPath() {
      return /databases/$(database)/documents/members/$(myEmail());
    }
    function member() {
      return get(memberPath()).data;
    }
    function hasRole(roles) {
      return signedIn() && exists(memberPath()) && member().role in roles;
    }
    function isOwner() { return hasRole(['owner']); }
    function isEditor() { return hasRole(['owner', 'editor']); }
    function isMember() { return hasRole(['owner', 'editor', 'viewer']); }
    function isRater() { return isEditor() && member().get('color', null) in ['azul', 'rosa']; }

    // ---------- Validación ----------

    function optString(v, max) {
      return v == null || (v is string && v.size() <= max);
    }
    function validScore(v) {
      return v == null
        || (v is number && v >= 1 && v <= 10 && math.floor(v * 2) == v * 2);
    }
    function validScores(s) {
      return s is map
        && s.keys().hasOnly(['producto', 'plato', 'tecnica', 'servicio', 'precio', 'ambiente'])
        && validScore(s.get('producto', null))
        && validScore(s.get('plato', null))
        && validScore(s.get('tecnica', null))
        && validScore(s.get('servicio', null))
        && validScore(s.get('precio', null))
        && validScore(s.get('ambiente', null));
    }
    function validRestaurant(d) {
      return d.keys().hasOnly(['name', 'locality', 'address', 'location', 'cuisines', 'price', 'visitDate', 'blog',
                               'photos', 'placeId', 'source', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && d.keys().hasAll(['name', 'locality', 'location', 'cuisines', 'price', 'visitDate', 'blog',
                            'photos', 'source', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.locality is string && d.locality.size() > 0 && d.locality.size() <= 60
        && optString(d.get('address', null), 200)
        && d.location is map && d.location.keys().hasOnly(['lat', 'lng'])
        && d.location.lat is number && d.location.lat >= -90 && d.location.lat <= 90
        && d.location.lng is number && d.location.lng >= -180 && d.location.lng <= 180
        && d.cuisines is list && d.cuisines.size() <= 10
        && d.price is int && d.price >= 1 && d.price <= 4
        && d.visitDate is string && d.visitDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.blog is string && d.blog.size() <= 20000
        && d.photos is list && d.photos.size() <= 30
        && optString(d.get('placeId', null), 300)
        && d.source in ['manual', 'places']
        && d.updatedBy == request.auth.uid
        && d.updatedAt == request.time;
    }
    function validRating(d) {
      return d.keys().hasOnly(['scores', 'global', 'dish', 'updatedAt'])
        && d.keys().hasAll(['scores', 'updatedAt'])
        && validScores(d.scores)
        && (d.get('global', null) == null || (d.global is number && d.global >= 1 && d.global <= 10))
        && optString(d.get('dish', null), 80)
        && d.updatedAt == request.time;
    }

    // ---------- Colecciones ----------

    // Papel y color de cada persona. El documento se llama como su correo en minúsculas.
    match /members/{email} {
      allow read: if signedIn() && (email == myEmail() || isOwner());
      allow write: if isOwner();
    }

    // Nombre visible y color (copia del de members, para que los invitados vean quién es quién).
    match /users/{uid} {
      allow read: if isMember();
      allow create, update: if isMember() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'color', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 30
        && request.resource.data.get('color', null) == member().get('color', null)
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner();
    }

    match /restaurants/{rid} {
      allow read: if isMember();
      allow create: if isEditor()
        && validRestaurant(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if isEditor()
        && validRestaurant(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner();

      // Nota de cada persona que puntúa: solo la escribe ella.
      match /ratings/{uid} {
        allow read: if isMember();
        allow create, update: if isRater() && request.auth.uid == uid && validRating(request.resource.data);
        allow delete: if (isRater() && request.auth.uid == uid) || isOwner();
      }
    }

    // Lectura de todas las notas de una vez (consulta de grupo de colecciones).
    match /{path=**}/ratings/{uid} {
      allow read: if isMember();
    }

    // Solicitudes de acceso. Las resuelven los propietarios.
    match /accessRequests/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'status', 'createdAt'])
        && request.resource.data.email == myEmail()
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update, delete: if isOwner();
    }
  }
}

rules_version = '2';

// Reglas de Firestore de Puntuam a taula (docs/diseno.md).
// Leer restaurantes, notas y nombres visibles: cualquiera, sin entrar (app pública en solo lectura desde el
// 24 de noviembre de 2026). Escribir: según el papel en members/{correo}: owner (propietario) o editor.
// Puntúa quien es propietario o editor y tiene color (azul o rosa). El papel viewer ya no hace falta.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Quién es quién ----------

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function memberPath() {
      return /databases/$(database)/documents/members/$(myEmail());
    }
    function member() {
      return get(memberPath()).data;
    }
    function hasRole(roles) {
      return signedIn() && exists(memberPath()) && member().role in roles;
    }
    function isOwner() { return hasRole(['owner']); }
    function isEditor() { return hasRole(['owner', 'editor']); }
    function isMember() { return hasRole(['owner', 'editor', 'viewer']); }
    function isRater() { return isEditor() && member().get('color', null) in ['azul', 'rosa']; }

    // ---------- Validación ----------

    function optString(v, max) {
      return v == null || (v is string && v.size() <= max);
    }
    // Notas de 1 a 10 con una décima (8,6), desde el 24 de noviembre de 2026; antes, medios puntos.
    // El margen cubre el redondeo de los decimales (1,1 × 10 da 11,000000000000002).
    function validScore(v) {
      return v == null
        || (v is number && v >= 1 && v <= 10 && math.abs(v * 10 - math.round(v * 10)) < 0.001);
    }
    function validScores(s) {
      return s is map
        && s.keys().hasOnly(['producto', 'plato', 'tecnica', 'servicio', 'precio', 'ambiente'])
        && validScore(s.get('producto', null))
        && validScore(s.get('plato', null))
        && validScore(s.get('tecnica', null))
        && validScore(s.get('servicio', null))
        && validScore(s.get('precio', null))
        && validScore(s.get('ambiente', null));
    }
    function validLocation(l) {
      return l is map && l.keys().hasOnly(['lat', 'lng'])
        && l.lat is number && l.lat >= -90 && l.lat <= 90
        && l.lng is number && l.lng >= -180 && l.lng <= 180;
    }
    // Otros locales de la misma ficha, hasta tres (25 de noviembre de 2026). Las reglas no recorren listas:
    // se comprueba cada posición.
    function validBranch(b) {
      return b is map && b.keys().hasOnly(['address', 'location', 'placeId']) && b.keys().hasAll(['location'])
        && optString(b.get('address', null), 200)
        && optString(b.get('placeId', null), 300)
        && validLocation(b.location);
    }
    function validBranches(l) {
      return l is list && l.size() <= 3
        && (l.size() < 1 || validBranch(l[0]))
        && (l.size() < 2 || validBranch(l[1]))
        && (l.size() < 3 || validBranch(l[2]));
    }
    // Precio: cinco tramos (1 a 5) desde el 24 de noviembre de 2026; antes, cuatro.
    // visitDate null: «Pendent de visitar» (24 de noviembre de 2026).
    // featured: recomendación de la página de inicio, opcional (24 de noviembre de 2026).
    // branches: otros locales, opcional (25 de noviembre de 2026).
    // price null: «Sense preu» (25 de noviembre de 2026).
    function validRestaurant(d) {
      return d.keys().hasOnly(['name', 'locality', 'address', 'location', 'cuisines', 'price', 'visitDate', 'blog',
                               'photos', 'placeId', 'source', 'featured', 'branches',
                               'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && d.keys().hasAll(['name', 'locality', 'location', 'cuisines', 'price', 'visitDate', 'blog',
                            'photos', 'source', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.locality is string && d.locality.size() > 0 && d.locality.size() <= 60
        && optString(d.get('address', null), 200)
        && validLocation(d.location)
        && validBranches(d.get('branches', []))
        && d.cuisines is list && d.cuisines.size() <= 10
        && (d.price == null || (d.price is int && d.price >= 1 && d.price <= 5))
        && (d.visitDate == null || (d.visitDate is string && d.visitDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && d.get('featured', false) is bool
        && d.blog is string && d.blog.size() <= 20000
        && d.photos is list && d.photos.size() <= 30
        && optString(d.get('placeId', null), 300)
        && d.source in ['manual', 'places']
        && d.updatedBy == request.auth.uid
        && d.updatedAt == request.time;
    }
    function validRating(d) {
      return d.keys().hasOnly(['scores', 'global', 'dish', 'updatedAt'])
        && d.keys().hasAll(['scores', 'updatedAt'])
        && validScores(d.scores)
        && (d.get('global', null) == null || (d.global is number && d.global >= 1 && d.global <= 10))
        && optString(d.get('dish', null), 80)
        && d.updatedAt == request.time;
    }

    // ---------- Colecciones ----------

    // Papel y color de cada persona. El documento se llama como su correo en minúsculas.
    match /members/{email} {
      allow read: if signedIn() && (email == myEmail() || isOwner());
      allow write: if isOwner();
    }

    // Nombre visible y color (copia del de members, para que se vea quién es quién). Sin correos.
    match /users/{uid} {
      allow read: if true;
      allow create, update: if isMember() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'color', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 30
        && request.resource.data.get('color', null) == member().get('color', null)
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner();
    }

    match /restaurants/{rid} {
      allow read: if true;
      allow create: if isEditor()
        && validRestaurant(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if isEditor()
        && validRestaurant(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner();

      // Nota de cada persona que puntúa: solo la escribe ella.
      match /ratings/{uid} {
        allow read: if true;
        allow create, update: if isRater() && request.auth.uid == uid && validRating(request.resource.data);
        allow delete: if (isRater() && request.auth.uid == uid) || isOwner();
      }
    }

    // Lectura de todas las notas de una vez (consulta de grupo de colecciones).
    match /{path=**}/ratings/{uid} {
      allow read: if true;
    }

    // Las solicitudes de acceso (accessRequests) se quitaron al hacer la app pública: sin regla, nadie
    // las lee ni las escribe desde la app. Las que queden se borran en la consola.
  }
}
